{
  "dashboard": {
    "template": "dashboard",
    "layout": "overlay",
    "panel": {
      "side": "left",
      "width_px": 400,
      "look": "frame",
      "sections": [],
      "hide": [
        "base_map",
        "colour_by",
        "legend"
      ]
    },
    "toolbar": {
      "position": "left",
      "settings": true,
      "hold": false,
      "navigation": "box"
    },
    "windows": {
      "clamp": true,
      "recenter_map": false,
      "restore_open": true,
      "remember": true
    },
    "boundary": {
      "dim": false,
      "limit": false,
      "dim_light": 0.16,
      "dim_dark": 0.4,
      "limit_pad": 2.0,
      "zoom_out": 3.0
    },
    "google_3d": {
      "fov_deg": null,
      "follow": true,
      "min_alt_m": 80.0,
      "min_zoom_drawn": 17.0,
      "mesh_altitude_m": 1.5,
      "selection_style": {
        "color": "#22d3ee",
        "width": 8.0,
        "outline": "#0b1020",
        "outline_width": 2.0,
        "arrow_color": "#ffffff",
        "arrow_width": 5.0,
        "arrow_every": 25.0,
        "fill": "rgba(34,211,238,0.35)"
      },
      "layers": []
    },
    "legend": {
      "rows": []
    },
    "credits": [
      {
        "text": "© OpenStreetMap contributors",
        "href": "https://www.openstreetmap.org/copyright"
      }
    ],
    "scale_box": false,
    "phone": {
      "max_width_px": 700,
      "toolbar": "top"
    }
  },
  "first_paint": {
    "classes": [
      "rs-tpl-dashboard",
      "rs-overlay",
      "rs-has-toolbar",
      "rs-tb-left",
      "rs-panel-left",
      "rs-hide-scale"
    ],
    "panel_width_px": 400,
    "phone_max_width_px": 700
  },
